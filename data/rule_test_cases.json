{
  "_how_to_read_setup": {
    "baseline": "seed_data.json starting_events as written",
    "carehome_offline_since_hours": "care home disconnected from GP and pharmacy from this time onwards (null = online the whole time)",
    "add_events": "extra events to add to the log. 'received_by_carehome: false' means it exists at the GP/pharmacy but never reached the offline care home",
    "remove_events": "seed events to delete first",
    "override_medications": "change fields on seed medications"
  },

  "cases": [

    { "id": "R1-F1", "rule": "R1", "description": "THE DEMO: INR 32h ago, GP changed dose but care home offline so never received it",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6,
                 "add_events": [ { "t_hours": -4, "type": "RX_CHANGED", "author": "gp", "resident_id": "R1", "medication_id": "M1", "old_dose": "5mg", "new_dose": "3mg", "new_rx_version": 2, "received_by_carehome": false } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": true, "severity": "hold" } },

    { "id": "R1-N1", "rule": "R1", "description": "Online all day: care home received the dose change, so nothing is missing",
      "setup": { "baseline": true, "carehome_offline_since_hours": null,
                 "add_events": [ { "t_hours": -4, "type": "RX_CHANGED", "author": "gp", "resident_id": "R1", "medication_id": "M1", "old_dose": "5mg", "new_dose": "3mg", "new_rx_version": 2, "received_by_carehome": true } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false, "_also": "dose due shown as 3mg, rx_version 2" } },

    { "id": "R1-N2", "rule": "R1", "description": "Dose change arrived BEFORE the network dropped",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6,
                 "add_events": [ { "t_hours": -7, "type": "RX_CHANGED", "author": "gp", "resident_id": "R1", "medication_id": "M1", "old_dose": "5mg", "new_dose": "3mg", "new_rx_version": 2, "received_by_carehome": true } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false } },

    { "id": "R1-N3", "rule": "R1", "description": "GP confirmed 'INR in range, keep 5mg' before the network dropped",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6,
                 "add_events": [ { "t_hours": -8, "type": "RX_CONFIRMED", "author": "gp", "resident_id": "R1", "medication_id": "M1", "rx_version": 1, "reason": "INR 2.6, in range, continue 5mg", "received_by_carehome": true } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false } },

    { "id": "R1-N4", "rule": "R1", "description": "INR only 10h ago: still inside the 24h window, so not overdue yet",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6,
                 "remove_events": [ { "type": "OBSERVATION", "resident_id": "R1", "kind": "INR_taken" } ],
                 "add_events": [ { "t_hours": -10, "type": "OBSERVATION", "author": "carehome", "resident_id": "R1", "kind": "INR_taken" } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false } },

    { "id": "R1-N5", "rule": "R1", "description": "No INR taken at all: nothing to wait for",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6,
                 "remove_events": [ { "type": "OBSERVATION", "resident_id": "R1", "kind": "INR_taken" } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false } },

    { "id": "R1-N6", "rule": "R1", "description": "R1 holds warfarin only, never Margaret's other medicines",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6 },
      "check_at_hours": 14, "medication_id": "M2",
      "expect": { "fires": false, "_why": "Amlodipine 08:00 next morning must not be held" } },

    { "id": "R1-N7", "rule": "R1", "description": "Network drops but it is not dose time yet: R1 waits for the round",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6 },
      "check_at_hours": -5, "medication_id": "M1",
      "expect": { "fires": false } },


    { "id": "R2-F1", "rule": "R2", "description": "High-risk drug, no sync with GP for 26h",
      "setup": { "baseline": true, "carehome_offline_since_hours": -26,
                 "remove_events": [ { "type": "OBSERVATION", "resident_id": "R1", "kind": "INR_taken" } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": true, "severity": "warn" } },

    { "id": "R2-N1", "rule": "R2", "description": "Offline 20h: under the 24h threshold",
      "setup": { "baseline": true, "carehome_offline_since_hours": -20,
                 "remove_events": [ { "type": "OBSERVATION", "resident_id": "R1", "kind": "INR_taken" } ] },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false } },

    { "id": "R2-N2", "rule": "R2", "description": "Offline 26h but amlodipine is not high-risk",
      "setup": { "baseline": true, "carehome_offline_since_hours": -12 },
      "check_at_hours": 14, "medication_id": "M2",
      "expect": { "fires": false } },


    { "id": "R3-F1", "rule": "R3", "description": "Scanned pack is NEWER than the care home's record",
      "setup": { "baseline": true, "scan": { "pack_code": "R1|M1|warfarin|3mg|v2", "local_rx_version": 1, "giving_to_resident": "R1" } },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": true, "severity": "hold", "message_contains": "newer prescription" } },

    { "id": "R3-F2", "rule": "R3", "description": "Scanned pack is OLDER than the record (old stock left in the trolley)",
      "setup": { "baseline": true, "scan": { "pack_code": "R1|M1|warfarin|5mg|v1", "local_rx_version": 2, "giving_to_resident": "R1" } },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": true, "severity": "hold", "message_contains": "old pack" } },

    { "id": "R3-F3", "rule": "R3", "description": "Wrong resident's pack scanned",
      "setup": { "baseline": true, "scan": { "pack_code": "R1|M1|warfarin|5mg|v1", "local_rx_version": 1, "giving_to_resident": "R3" } },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": true, "severity": "hold", "message_contains": "wrong pack" } },

    { "id": "R3-N1", "rule": "R3", "description": "Pack and record match",
      "setup": { "baseline": true, "scan": { "pack_code": "R1|M1|warfarin|5mg|v1", "local_rx_version": 1, "giving_to_resident": "R1" } },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false } },


    { "id": "R4-F1", "rule": "R4", "description": "Arthur's 12:00 Sinemet given at 12:45 (45 min late)",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -5.25, "type": "DOSE_GIVEN", "author": "carehome", "resident_id": "R2", "medication_id": "M4", "scheduled_time": "12:00", "given_at": "12:45" } ] },
      "check_at_hours": 0, "medication_id": "M4",
      "expect": { "fires": true, "severity": "warn", "count": 1, "message_contains": "late" } },

    { "id": "R4-F2", "rule": "R4", "description": "Arthur's 12:00 dose never recorded (baseline as loaded)",
      "setup": { "baseline": true },
      "check_at_hours": 0, "medication_id": "M4",
      "expect": { "fires": true, "severity": "warn", "count": 1, "message_contains": "not recorded" } },

    { "id": "R4-N1", "rule": "R4", "description": "Given 20 min late: within the 30 min limit",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -5.67, "type": "DOSE_GIVEN", "author": "carehome", "resident_id": "R2", "medication_id": "M4", "scheduled_time": "12:00", "given_at": "12:20" } ] },
      "check_at_hours": 0, "medication_id": "M4",
      "expect": { "fires": false } },

    { "id": "R4-N2", "rule": "R4", "description": "Boundary: given exactly 30 min late is NOT late (rule is MORE than 30)",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -5.5, "type": "DOSE_GIVEN", "author": "carehome", "resident_id": "R2", "medication_id": "M4", "scheduled_time": "12:00", "given_at": "12:30" } ] },
      "check_at_hours": 0, "medication_id": "M4",
      "expect": { "fires": false } },

    { "id": "R4-N3", "rule": "R4", "description": "Amlodipine given 2h late: not time-critical, so no R4",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -8, "type": "DOSE_GIVEN", "author": "carehome", "resident_id": "R1", "medication_id": "M2", "scheduled_time": "08:00", "given_at": "10:00" } ] },
      "check_at_hours": 0, "medication_id": "M2",
      "expect": { "fires": false } },

    { "id": "R4-N4", "rule": "R4", "description": "PRN paracetamol never triggers R4",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -3, "type": "DOSE_GIVEN", "author": "carehome", "resident_id": "R1", "medication_id": "M3", "scheduled_time": null, "given_at": "15:00" } ] },
      "check_at_hours": 0, "medication_id": "M3",
      "expect": { "fires": false } },

    { "id": "R4-N5", "rule": "R4", "description": "Alias check: medication written as 'Sinemet' is still treated as time-critical",
      "setup": { "baseline": true, "override_medications": { "M4": { "drug": "Sinemet" } },
                 "add_events": [ { "t_hours": -5.25, "type": "DOSE_GIVEN", "author": "carehome", "resident_id": "R2", "medication_id": "M4", "scheduled_time": "12:00", "given_at": "12:45" } ] },
      "check_at_hours": 0, "medication_id": "M4",
      "expect": { "fires": true, "severity": "warn" } },


    { "id": "R5-F1", "rule": "R5", "description": "Arthur's co-careldopa: 22 doses / 4 a day = 5.5 days left",
      "setup": { "baseline": true },
      "check_at_hours": 0, "medication_id": "M4",
      "expect": { "fires": true, "creates": { "type": "REPEAT_REQUESTED", "quantity": 112, "auto_drafted": true } } },

    { "id": "R5-F2", "rule": "R5", "description": "Doris's furosemide after the '3 left in the pack' note",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "OBSERVATION", "author": "carehome", "resident_id": "R3", "kind": "stock_count", "detail": "furosemide 3 left", "stock_doses": 3 } ] },
      "check_at_hours": 0, "medication_id": "M6",
      "expect": { "fires": true, "creates": { "type": "REPEAT_REQUESTED", "quantity": 28, "auto_drafted": true } } },

    { "id": "R5-N1", "rule": "R5", "description": "Doris's furosemide on load: 10 days left",
      "setup": { "baseline": true },
      "check_at_hours": 0, "medication_id": "M6",
      "expect": { "fires": false } },

    { "id": "R5-N2", "rule": "R5", "description": "Boundary: exactly 7 days left does NOT fire (rule is LESS than 7)",
      "setup": { "baseline": true, "override_medications": { "M1": { "stock_doses": 7 } } },
      "check_at_hours": 0, "medication_id": "M1",
      "expect": { "fires": false } },

    { "id": "R5-N3", "rule": "R5", "description": "PRN paracetamol with only 2 doses left: skipped, and must not crash",
      "setup": { "baseline": true, "override_medications": { "M3": { "stock_doses": 2 } } },
      "check_at_hours": 0, "medication_id": "M3",
      "expect": { "fires": false, "_also": "no exception / divide-by-zero" } },

    { "id": "R5-N4", "rule": "R5", "description": "Repeat already requested: don't draft a duplicate",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "REPEAT_REQUESTED", "author": "carehome", "resident_id": "R2", "medication_id": "M4", "quantity": 112, "auto_drafted": false } ] },
      "check_at_hours": 0, "medication_id": "M4",
      "expect": { "fires": false } },


    { "id": "R6-F1", "rule": "R6", "description": "Ibuprofen prescribed for Margaret, who takes warfarin",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "RX_CREATED", "author": "gp", "resident_id": "R1", "medication_id": "M8", "drug": "Ibuprofen", "dose": "400mg", "times": ["08:00", "14:00", "20:00"], "rx_version": 1 } ] },
      "check_at_hours": -1, "medication_id": "M8",
      "expect": { "fires": true, "action": "block", "message_contains": "Bleeding" } },

    { "id": "R6-F2", "rule": "R6", "description": "Methotrexate written as once DAILY",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "RX_CREATED", "author": "gp", "resident_id": "R3", "medication_id": "M9", "drug": "Methotrexate", "dose": "10mg", "frequency": "once daily", "rx_version": 1 } ] },
      "check_at_hours": -1, "medication_id": "M9",
      "expect": { "fires": true, "action": "block" } },

    { "id": "R6-F3", "rule": "R6", "description": "Case check: 'IBUPROFEN' in capitals still caught",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "RX_CREATED", "author": "gp", "resident_id": "R1", "medication_id": "M8", "drug": "IBUPROFEN", "dose": "400mg", "rx_version": 1 } ] },
      "check_at_hours": -1, "medication_id": "M8",
      "expect": { "fires": true, "action": "block" } },

    { "id": "R6-N1", "rule": "R6", "description": "Methotrexate correctly written once WEEKLY",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "RX_CREATED", "author": "gp", "resident_id": "R3", "medication_id": "M9", "drug": "Methotrexate", "dose": "10mg", "frequency": "once weekly", "rx_version": 1 } ] },
      "check_at_hours": -1, "medication_id": "M9",
      "expect": { "fires": false } },

    { "id": "R6-F4", "rule": "R6", "description": "Ibuprofen for Doris, who takes sertraline (SSRI + NSAID = stomach bleed risk)",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "RX_CREATED", "author": "gp", "resident_id": "R3", "medication_id": "M8", "drug": "Ibuprofen", "dose": "400mg", "rx_version": 1 } ] },
      "check_at_hours": -1, "medication_id": "M8",
      "expect": { "fires": true, "action": "pharmacist review" } },

    { "id": "R6-N2", "rule": "R6", "description": "Ibuprofen for Arthur: none of his medicines are in our interaction list",
      "setup": { "baseline": true,
                 "add_events": [ { "t_hours": -1, "type": "RX_CREATED", "author": "gp", "resident_id": "R2", "medication_id": "M8", "drug": "Ibuprofen", "dose": "400mg", "rx_version": 1 } ] },
      "check_at_hours": -1, "medication_id": "M8",
      "expect": { "fires": false, "_why": "Interactions only count between the SAME resident's medicines; Margaret's warfarin must not affect Arthur" } },


    { "id": "R7-F1", "rule": "R7", "description": "Dose change sent at -4h, no acknowledgement by -2h",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6,
                 "add_events": [ { "t_hours": -4, "type": "RX_CHANGED", "author": "gp", "resident_id": "R1", "medication_id": "M1", "old_dose": "5mg", "new_dose": "3mg", "new_rx_version": 2, "received_by_carehome": false } ] },
      "check_at_hours": -2, "medication_id": "M1",
      "expect": { "fires": true, "severity": "warn", "node": "gp" } },

    { "id": "R7-N1", "rule": "R7", "description": "Care home acknowledged 30 min after the change",
      "setup": { "baseline": true, "carehome_offline_since_hours": null,
                 "add_events": [
                   { "t_hours": -4, "type": "RX_CHANGED", "author": "gp", "resident_id": "R1", "medication_id": "M1", "old_dose": "5mg", "new_dose": "3mg", "new_rx_version": 2, "received_by_carehome": true },
                   { "t_hours": -3.5, "type": "RX_ACKNOWLEDGED", "author": "carehome", "resident_id": "R1", "medication_id": "M1", "rx_version": 2 } ] },
      "check_at_hours": -2, "medication_id": "M1",
      "expect": { "fires": false } },

    { "id": "R7-N2", "rule": "R7", "description": "Only 1.5h since the change: too early to chase",
      "setup": { "baseline": true, "carehome_offline_since_hours": -6,
                 "add_events": [ { "t_hours": -4, "type": "RX_CHANGED", "author": "gp", "resident_id": "R1", "medication_id": "M1", "old_dose": "5mg", "new_dose": "3mg", "new_rx_version": 2, "received_by_carehome": false } ] },
      "check_at_hours": -2.5, "medication_id": "M1",
      "expect": { "fires": false } }
  ]
}
